{
  "Type": "Generic",
  "Parameters": {
    "MaxHealth": {
      "Value": 100,
      "Description": "Maksymalne HP kompana"
    }
  },
  "StartState": "Idle",
  "Appearance": "Kweebec_Rootling",
  "MaxHealth": {
    "Compute": "MaxHealth"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 5,
      "RunThreshold": 0.6,
      "Gravity": 10,
      "Acceleration": 12
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "1. IDLE - Stoi w miejscu (NONE / STAY)",
          "Sensor": { "Type": "State", "State": "Idle" },
          "Instructions": [
            {
              "$Comment": "Dummy setter dla walidatora — zakres 0.1 praktycznie nigdy nie odfali",
              "Sensor": { "Type": "Mob", "Range": 0.1 },
              "Actions": [{ "Type": "State", "State": "Attack" }]
            },
            {
              "Sensor": { "Type": "Any" },
              "BodyMotion": { "Type": "Nothing" }
            }
          ]
        },
        {
          "$Comment": "2. FOLLOW - Podaza za graczem; atak kontrolowany wylacznie przez Jave (RL/LLM)",
          "Sensor": { "Type": "State", "State": "Follow" },
          "Instructions": [
            {
              "Sensor": { "Type": "Player", "Range": 100, "LockOnTarget": true },
              "BodyMotion": { "Type": "Seek", "StopDistance": 3.0 }
            }
          ]
        },
        {
          "$Comment": "3. ATTACK - Wykrywa najblizszego NPC i atakuje",
          "Sensor": { "Type": "State", "State": "Attack" },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Mob",
                "Range": 20,
                "LockOnTarget": true
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Target",
                    "Range": 2.5,
                    "Filters": [{ "Type": "LineOfSight" }]
                  },
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "Attack",
                      "Attack": "Root_NPC_ai_companion_attack",
                      "AttackPauseRange": [1.0, 2.0]
                    }
                  ],
                  "HeadMotion": { "Type": "Aim", "RelativeTurnSpeed": 2.0 }
                },
                {
                  "Sensor": { "Type": "Target" },
                  "BodyMotion": { "Type": "Seek", "StopDistance": 1.5, "RelativeSpeed": 1.5 }
                }
              ]
            },
            {
              "Sensor": { "Type": "Any" },
              "Actions": [{ "Type": "State", "State": "Follow" }]
            }
          ]
        },
        {
          "$Comment": "4. FLEE - Ucieka od gracza; gdy zagrozenie minie przechodzi do Heal",
          "Sensor": { "Type": "State", "State": "Flee" },
          "Instructions": [
            {
              "Sensor": { "Type": "Player", "Range": 20 },
              "BodyMotion": { "Type": "Flee" }
            },
            {
              "Sensor": { "Type": "Any" },
              "Actions": [{ "Type": "State", "State": "Heal" }]
            }
          ]
        },
        {
          "$Comment": "5. HEAL - Stoi i sie leczy (Java); gdy pojawi sie wrog ucieka",
          "Sensor": { "Type": "State", "State": "Heal" },
          "Instructions": [
            {
              "Sensor": { "Type": "Mob", "Range": 15 },
              "Actions": [{ "Type": "State", "State": "Flee" }]
            },
            {
              "Sensor": { "Type": "Any" },
              "BodyMotion": { "Type": "Nothing" }
            }
          ]
        },
        {
          "$Comment": "6. TALK - Stoi, patrzy na gracza i gra animacje Alerted",
          "Sensor": { "Type": "State", "State": "Talk" },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Any", "Once": true },
              "Actions": [
                { "Type": "PlayAnimation", "Slot": "Status", "Animation": "Alerted" }
              ]
            },
            {
              "Continue": true,
              "Sensor": { "Type": "Player", "Range": 30 },
              "HeadMotion": { "Type": "Watch" }
            },
            {
              "Sensor": { "Type": "Any" },
              "BodyMotion": { "Type": "Nothing" },
              "ActionsBlocking": true,
              "Actions": [
                { "Type": "Timeout", "Delay": [3, 3] },
                { "Type": "PlayAnimation", "Slot": "Status" },
                { "Type": "State", "State": "Idle" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Prawy przycisk myszy inicjuje dialog z graczem - stan AiChat obslugiwany po stronie Javy",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [{ "Type": "SetInteractable", "Interactable": true }]
      },
      {
        "Sensor": { "Type": "HasInteracted" },
        "Instructions": [
          {
            "Sensor": { "Type": "Any" },
            "Actions": [
              { "Type": "LockOnInteractionTarget" },
              { "Type": "State", "State": "Talk" }
            ]
          }
        ]
      }
    ]
  },
  "NameTranslationKey": "server.npcRoles.ai_companion.name"
}
